# =====================================
# 3. LANGUAGE DETECTION
# =====================================

def is_arabic(text):
    return bool(re.search(r'[\u0600-\u06FF]', text))


def normalize_text(text):

    text = text.lower().strip()

    replacements = {
        "أ": "ا",
        "إ": "ا",
        "آ": "ا",
        "ة": "ه",
        "ى": "ي"
    }

    for old, new in replacements.items():
        text = text.replace(old, new)

    return text


