        font=("Arial", 12, "bold")
    )

    chat_area.insert(
        tk.END,
        f"Assistant: Hello {student_name}!\nWelcome to Innovation University.\n\n",
        "assistant"
    )

    chat_area.config(state="disabled")

    # Quick Questions

    faq_frame = tk.Frame(root, bg="#EAF2F8")

    faq_frame.pack(pady=5)

    tk.Label(
        faq_frame,
        text="QUICK QUESTIONS:",
        font=("Arial", 10, "bold"),
        bg="#EAF2F8",
