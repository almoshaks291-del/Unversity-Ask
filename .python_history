# 6. CHAT FUNCTIONS
# =====================================

def add_message(sender, message, tag):

    chat_area.config(state="normal")

    chat_area.insert(tk.END, sender + ": ", tag)

    chat_area.insert(tk.END, message + "\n\n")

    chat_area.config(state="disabled")

    chat_area.see(tk.END)


def send_message(text=None):

    question = text if text is not None else message_entry.get().strip()

    if not question:
        return

    sender = "أنت" if is_arabic(question) else "You"

    add_message(sender, question, "user")

    answer = get_response(question)

    assistant_name = "المساعد" if is_arabic(question) else "Assistant"

    add_message(assistant_name, answer, "assistant")

    message_entry.delete(0, tk.END)


def clear_chat():

    chat_area.config(state="normal")

    chat_area.delete("1.0", tk.END)

    chat_area.insert(
        tk.END,
        "Assistant: Welcome to University Assistant!\n\n",
        "assistant"
    )

    chat_area.config(state="disabled")


def on_enter(event):

    send_message()

    return "break"


