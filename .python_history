# =====================================
# 5. GET RESPONSE
# =====================================

def get_response(question):

    original_question = question
    question = normalize_text(question)

    arabic = is_arabic(original_question)

    if not question:
        return "من فضلك اكتب سؤالك." if arabic else "Please enter a question."

    # Keyword matching

    keywords = {
        "greeting": ["hello", "hi", "hey", "مرحبا", "اهلا", "السلام عليكم"],
        "hours": ["مواعيد", "ساعات العمل", "بتفتح", "بتقفل", "working hours", "university hours"],
        "departments": ["الاقسام", "التخصصات", "departments"],
        "exams": ["امتحان", "الامتحانات", "جدول الامتحانات", "exams"],
        "affairs": ["شؤون الطلاب", "شئون الطلاب", "student affairs"],
        "university": ["الجامعة", "university", "innovation university"],
        "cs": ["علوم الحاسب", "حاسبات", "computer science"],
        "lms": ["lms", "منصة التعليم"],
        "sis": ["sis", "نظام الطلاب"],
        "email": ["الايميل", "البريد الالكتروني", "email"],
        "hub": ["student hub", "ستودنت هب"]
    }

    for intent, words in keywords.items():

        for word in words:

            if normalize_text(word) in question:
                return responses[intent][0 if arabic else 1]

    # Machine Learning prediction

    question_vector = vectorizer.transform([question])

    probabilities = model.predict_proba(question_vector)[0]

    best_index = int(probabilities.argmax())

    confidence = probabilities[best_index]

    if confidence < 0.30:

        if arabic:
            return "عذراً، لم أفهم سؤالك. حاول بطريقة أخرى."

        return "Sorry, I don't understand. Please try another question."

    prediction = model.classes_[best_index]

    return responses[prediction][0 if arabic else 1]


