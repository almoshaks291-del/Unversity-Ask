    ).pack()

    quick_questions = [
        "Working hours",
        "Departments",
        "Exams",
        "LMS",
        "SIS",
        "Student Hub"
    ]

    for q in quick_questions:

        tk.Button(
            faq_frame,
            text=q,
            bg="#D6E4F0",
            fg="#17365D",
            command=lambda question=q: send_message(question)
        ).pack(side="left", padx=3, pady=8)

    # Input Area

    input_frame = tk.Frame(root, bg="#EAF2F8")

    input_frame.pack(fill="x", padx=20, pady=10)

    message_entry = tk.Entry(
        input_frame,
        font=("Arial", 13)
    )

    message_entry.pack(
        side="left",
        fill="x",
        expand=True,
        ipady=10
    )

    message_entry.bind("<Return>", on_enter)

    tk.Button(
        input_frame,
        text="SEND",
        bg="#17365D",
        fg="white",
        command=send_message,
        padx=20,
        pady=8
    ).pack(side="left", padx=8)

    tk.Button(
        input_frame,
        text="CLEAR CHAT",
        bg="#B4C7E7",
        command=clear_chat,
        padx=10,
        pady=8
    ).pack(side="left")

    # Logout

    tk.Button(
        root,
        text="LOGOUT",
        bg="#C0504D",
        fg="white",
        command=lambda: logout(root),
        padx=20,
        pady=6
    ).pack(pady=8)

    message_entry.focus()


